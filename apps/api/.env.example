# --- App ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://mobilepay:mobilepay_dev_password@localhost:5432/mobilepay?schema=public"

# --- Redis (cache, rate limiting, future queues) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Encryption (données sensibles au repos : mfaSecret, etc.) ---
ENCRYPTION_KEY="32-byte-hex-key-generate-with-openssl-rand-hex-32"

# --- HUB2 (provider de paiement local — sandbox) ---
HUB2_BASE_URL="https://sandbox.hub2.io/v1"
HUB2_API_KEY=""
HUB2_WEBHOOK_SECRET=""

# --- Stripe (stub — Phase 6) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- PayPal (stub — Phase 6, Sandbox obligatoire avant prod) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# --- Reloadly (stub — Phase 6) ---
RELOADLY_CLIENT_ID=""
RELOADLY_CLIENT_SECRET=""

# --- Frontend ---
WEB_APP_URL="http://localhost:3001"
QR_LINK_BASE_URL="https://pay.mobilepay.ci"

# --- App ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# Origines autorisées en CORS, séparées par des virgules — à remplacer en
# production par les 3 vraies URLs Vercel une fois déployées.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Database ---
DATABASE_URL="postgresql://mobilepay:mobilepay_dev_password@localhost:5432/mobilepay?schema=public"

# --- Redis (cache, rate limiting, future queues) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Encryption (données sensibles au repos : mfaSecret, etc.) ---
ENCRYPTION_KEY="32-byte-hex-key-generate-with-openssl-rand-hex-32"

# --- HUB2 (provider de paiement local) ---
# Base URL exacte à confirmer depuis votre tableau de bord HUB2 (varie selon
# sandbox/live) — https://api.hub2.io est le domaine confirmé par la doc,
# vérifiez le chemin exact avec votre contact HUB2 si besoin.
HUB2_BASE_URL="https://api.hub2.io"
HUB2_API_KEY=""
HUB2_MERCHANT_ID=""
HUB2_ENVIRONMENT="sandbox"
HUB2_WEBHOOK_SECRET=""
# Solde de départ pré-financé sur le compte transfert (pay-out) HUB2, en
# centimes — additionné au vrai solde une fois l'API connectée (§ dashboard
# admin, page Providers). 25 000 000 = 250 000 FCFA.
HUB2_PAYOUT_DEFAULT_BALANCE_CENTS="25000000"

# --- Stripe (stub — Phase 6) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- PayPal (stub — Phase 6, Sandbox obligatoire avant prod) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# --- Reloadly (stub — Phase 6) ---
RELOADLY_CLIENT_ID=""
RELOADLY_CLIENT_SECRET=""
RELOADLY_WEBHOOK_SECRET=""
# Solde de départ pré-financé sur le compte Reloadly, en centimes — additionné
# au vrai solde une fois l'API connectée. 5 000 000 = 50 000 FCFA.
RELOADLY_DEFAULT_BALANCE_CENTS="5000000"
RELOADLY_BASE_URL="https://topups-sandbox.reloadly.com"

# --- Frontend ---
WEB_APP_URL="http://localhost:3001"
QR_LINK_BASE_URL="https://pay.mobilepay-ci.com"
